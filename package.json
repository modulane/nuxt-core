{
  "name": "@modulane/nuxt-core",
  "version": "0.0.0-development",
  "description": "A reusable foundation for building modern websites with Nuxt.",
  "type": "module",
  "private": true,
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./design": "./layers/design/nuxt.config.ts",
    "./primitives": "./layers/primitives/nuxt.config.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "/layers",
    "/nuxt.config.ts"
  ],
  "scripts": {
    "dev": "nuxt dev playground",
    "build": "nuxt build playground",
    "generate": "nuxt generate playground",
    "preview": "nuxt preview playground",
    "dev:prepare": "nuxt prepare playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck playground",
    "check": "yarn format:check && yarn typecheck && yarn test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modulane/nuxt-core.git"
  },
  "homepage": "https://github.com/modulane/nuxt-core#readme",
  "bugs": {
    "url": "https://github.com/modulane/nuxt-core/issues"
  },
  "peerDependencies": {
    "nuxt": "^4.5.2"
  },
  "dependencies": {
    "sass": "^1.104.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.1",
    "@types/node": "^24",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.5.2",
    "prettier": "3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
